rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    } 

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username;
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read, update, delete: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.read == false
          && (
            (request.resource.data.type == 'comment'
              && request.resource.data.actorId != userId
              && get(/databases/$(database)/documents/releases/$(request.resource.data.releaseId)).data.ownerId == userId)
            ||
            (request.resource.data.type == 'reply'
              && request.resource.data.actorId != userId
              && get(/databases/$(database)/documents/releases/$(request.resource.data.releaseId)/comments/$(request.resource.data.commentId)).data.authorId == userId)
          );
      }
    }

    match /releases/{releaseId} {
      allow read: if resource.data.published == true
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.artist is string
        && request.resource.data.tracks is list;
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.get('creatorId', resource.data.ownerId) == resource.data.get('creatorId', resource.data.ownerId))
        ||
        (resource.data.published == true
          && resource.data.marketplaceListed == true
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.marketplaceListed == false
          && request.resource.data.published == false
          && request.resource.data.creatorId == resource.data.get('creatorId', resource.data.ownerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerId', 'ownerName', 'ownerAvatarUrl', 'ownerAvatarData',
            'creatorId', 'creatorName', 'creatorAvatarUrl', 'creatorAvatarData',
            'published', 'marketplaceListed', 'claimedAt', 'updatedAt'
          ]))
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /ratings/{userId} {
        allow read: if get(/databases/$(database)/documents/releases/$(releaseId)).data.published == true
          || (signedIn() && get(/databases/$(database)/documents/releases/$(releaseId)).data.ownerId == request.auth.uid);
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && get(/databases/$(database)/documents/releases/$(releaseId)).data.published == true
          && get(/databases/$(database)/documents/releases/$(releaseId)).data.ratingsEnabled == true
          && get(/databases/$(database)/documents/releases/$(releaseId)).data.ownerId != request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.score is int
          && request.resource.data.score >= 1
          && request.resource.data.score <= 10;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        function canViewRelease() {
          return get(/databases/$(database)/documents/releases/$(releaseId)).data.published == true
            || (signedIn() && get(/databases/$(database)/documents/releases/$(releaseId)).data.ownerId == request.auth.uid);
        }
        allow read: if canViewRelease();
        allow create: if signedIn()
          && canViewRelease()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;

        match /replies/{replyId} {
          allow read: if get(/databases/$(database)/documents/releases/$(releaseId)).data.published == true
            || (signedIn() && get(/databases/$(database)/documents/releases/$(releaseId)).data.ownerId == request.auth.uid);
          allow create: if signedIn()
            && (get(/databases/$(database)/documents/releases/$(releaseId)).data.published == true
              || get(/databases/$(database)/documents/releases/$(releaseId)).data.ownerId == request.auth.uid)
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000;
          allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
        }
      }
    }
  }
}
